+    async def _run_generation_independent_segments(
+        self,
+        audio_stream: AsyncGenerator[np.ndarray, None],
+        input_stream: asyncio.Queue[list[int]],
+        segment_metadata: list[dict[str, float]],
+    ) -> None:
