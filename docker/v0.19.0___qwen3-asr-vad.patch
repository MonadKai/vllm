+            completion_tokens=completion_tokens_len,
+            total_tokens=prompt_token_ids_len + completion_tokens_len,
+        )
+
+        language: str | None = None
+        segments_out: list[RealtimeTranscriptionSegment] | None = None
+        display_text = full_text
